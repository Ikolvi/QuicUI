import("//flutter/common/config.gni")
import("//flutter/testing/testing.gni")

source_set("snapshots_data_handle") {
  sources = [
    "snapshots_data_handle.cc",
    "snapshots_data_handle.h",
  ]

  deps = [
    "//flutter/fml",
    "//flutter/runtime",
    "//flutter/runtime:libdart",
    "//flutter/shell/common",
  ]
}

source_set("quicui") {
  sources = [
    "quicui.cc",
    "quicui.h",
  ]

  deps = [
    ":snapshots_data_handle",
    "//flutter/fml",
    "//flutter/runtime",
    "//flutter/runtime:libdart",
    "//flutter/shell/common",
    "//flutter/shell/platform/embedder:embedder_headers",
  ]

  include_dirs = [ "//flutter/updater" ]
}

if (enable_unittests) {
  test_fixtures("quicui_fixtures") {
    fixtures = []
  }

  executable("quicui_unittests") {
    testonly = true

    sources = [ "snapshots_data_handle_unittests.cc" ]

    # This only includes snapshots_data_handle and not quicui because
    # quicui fails to link due to a missing updater lib.
    deps = [
      ":quicui_fixtures",
      ":snapshots_data_handle",
      "//flutter/runtime",
      "//flutter/testing",
      "//flutter/testing:fixture_test",
    ]
  }
}

# QuicUI Code Push Backend - Environment Configuration
# 
# This file documents all environment variables required for the QuicUI backend.
# DO NOT commit actual .env files to version control.
# Copy this file to .env.local for development or .env.production for deployment.

# ============================================================================
# CRITICAL VARIABLES (REQUIRED IN PRODUCTION)
# ============================================================================

# Application environment
# Values: development, staging, production
# In development mode, security checks are relaxed (HTTP allowed, wildcard CORS, etc.)
# In production mode, strict security enforcement (HTTPS required, specific CORS origins, etc.)
QUICUI_ENVIRONMENT=production

# Allowed CORS origins (comma-separated)
# IMPORTANT: Do NOT use wildcard (*) in production
# Example for single origin: https://example.com
# Example for multiple origins: https://app.example.com,https://api.example.com
QUICUI_ALLOWED_ORIGINS=https://example.com,https://api.example.com

# ============================================================================
# TLS/HTTPS CONFIGURATION (REQUIRED IN PRODUCTION)
# ============================================================================

# Path to TLS certificate file (required for HTTPS in production)
# Example: /etc/ssl/certs/server.crt
QUICUI_TLS_CERT_PATH=/etc/ssl/certs/server.crt

# Path to TLS private key file (required for HTTPS in production)
# Example: /etc/ssl/private/server.key
QUICUI_TLS_KEY_PATH=/etc/ssl/private/server.key

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL database host
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=quicui_backend
DATABASE_USER=quicui_user
DATABASE_PASSWORD=secure_password_here

# ============================================================================
# AUTHENTICATION CONFIGURATION
# ============================================================================

# JWT signing secret key (minimum 32 bytes/256 bits)
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=your-secret-key-here-min-32-bytes

# JWT token expiration time in seconds
# Default: 3600 (1 hour)
JWT_EXPIRATION=3600

# API key for service-to-service authentication
# Generate with: openssl rand -hex 32
API_KEY_SECRET=your-api-key-secret-here

# ============================================================================
# OPTIONAL SECURITY CONFIGURATION
# ============================================================================

# Maximum request size in bytes
# Default: 10485760 (10MB)
QUICUI_MAX_REQUEST_SIZE=10485760

# Request timeout in seconds
# Default: 30
QUICUI_REQUEST_TIMEOUT=30

# Allow credentials in CORS requests (true/false)
# Default: false
QUICUI_CORS_ALLOW_CREDENTIALS=false

# Custom Content Security Policy
# Default: default-src 'self'
QUICUI_CSP_POLICY=default-src 'self'

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Server port
SERVER_PORT=8080

# Enable debug logging (true/false)
# Default: false
DEBUG_LOGGING=false

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================

# For Docker deployment:
# 1. Create .env.production file with all required variables
# 2. Mount TLS certificate and key files as Docker volumes
# 3. Load environment variables from .env.production
# 
# Example Docker run command:
# docker run \
#   --env-file .env.production \
#   -v /path/to/certs:/etc/ssl/certs:ro \
#   -v /path/to/keys:/etc/ssl/private:ro \
#   -p 8080:8080 \
#   quicui-backend:latest

# For Kubernetes deployment:
# 1. Create ConfigMap for non-sensitive variables
# 2. Create Secret for sensitive variables (passwords, keys)
# 3. Mount TLS certificates as Secrets
# 
# Example Kubernetes ConfigMap:
# apiVersion: v1
# kind: ConfigMap
# metadata:
#   name: quicui-config
# data:
#   QUICUI_ENVIRONMENT: production
#   QUICUI_ALLOWED_ORIGINS: https://example.com

# Example Kubernetes Secret:
# apiVersion: v1
# kind: Secret
# metadata:
#   name: quicui-secrets
# type: Opaque
# stringData:
#   DATABASE_PASSWORD: secure_password_here
#   JWT_SECRET_KEY: your-secret-key-here-min-32-bytes
#   API_KEY_SECRET: your-api-key-secret-here

# ============================================================================
# SECURITY BEST PRACTICES
# ============================================================================

# 1. Never commit actual .env files to version control
# 2. Use strong, randomly-generated secrets (minimum 32 bytes for cryptographic keys)
# 3. Rotate secrets regularly (at least annually for static keys)
# 4. Use environment-specific secret management (Vault, AWS Secrets Manager, etc.)
# 5. Restrict file permissions: chmod 600 .env.production
# 6. Use TLS certificates from trusted Certificate Authorities
# 7. Enable TLS certificate auto-renewal (e.g., Let's Encrypt with certbot)
# 8. Restrict database access to localhost or private network
# 9. Monitor logs for suspicious activity
# 10. Keep dependencies updated for security patches

# ============================================================================
# QUICK START COMMANDS
# ============================================================================

# Generate secrets:
# JWT_SECRET_KEY: openssl rand -base64 32
# API_KEY_SECRET: openssl rand -hex 32
# DATABASE_PASSWORD: pwgen -s 32 1

# Test configuration:
# dart run bin/verify_security_config.dart

# Start application:
# source .env.production && dart run quicui_backend

# With Docker:
# docker build -t quicui-backend:latest .
# docker run --env-file .env.production -p 8080:8080 quicui-backend:latest

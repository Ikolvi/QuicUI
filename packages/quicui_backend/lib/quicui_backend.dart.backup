import 'dart:async';
import 'dart:io';
import 'package:shelf/shelf.dart' as shelf;
import 'package:shelf/shelf_io.dart' as shelf_io;
import 'package:shelf_router/shelf_router.dart';
import 'src/security_config.dart';

// Export security configuration for external use
export 'src/security_config.dart' show SecurityConfig, SecurityConfigException;

/// Simple QuicUI Backend for local development
class CodePushBackend {
  final String host;
  final int port;
  
  CodePushBackend({
    this.host = 'localhost',
    this.port = 8080,
  });

  /// Start the backend server
  Future<void> start() async {
    try {
      print('🚀 Starting QuicUI Code Push Backend...');
      print('📝 Configuration:');
      print('   Host: $host');
      print('   Port: $port');
      print('   Environment: Development');

      // Load security configuration
      late SecurityConfig securityConfig;
      try {
        securityConfig = SecurityConfig.fromEnvironment();
        print('✅ Security configuration loaded');
      } catch (e) {
        print('⚠️ Security configuration warning: $e');
        // In development, use default config
        securityConfig = SecurityConfig(
          allowedOrigins: ['http://localhost:3000', 'http://localhost:3001'],
          debugMode: true,
        );
        print('✅ Using default development security config');
      }

      // Print security checklist
      securityConfig.printSecurityChecklistProduction();

      // Create router
      final router = Router();

      // Health check endpoint
      router.get('/health', (shelf.Request request) {
        return shelf.Response.ok(
          '{"status":"healthy"}',
          headers: {'Content-Type': 'application/json'},
        );
      });

      // API v1 endpoints
      router.get('/api/v1/apps', (shelf.Request request) {
        return shelf.Response.ok(
          '{"apps":[]}',
          headers: {'Content-Type': 'application/json'},
        );
      });

      router.post('/api/v1/auth/login', (shelf.Request request) {
        return shelf.Response.ok(
          '{"token":"jwt.token.here"}',
          headers: {'Content-Type': 'application/json'},
        );
      });

      // 404 handler
      router.all('/<path|.*>', (shelf.Request request) {
        return shelf.Response.notFound('{"error":"Not found"}',
          headers: {'Content-Type': 'application/json'},
        );
      });

      // Create handler with security middleware
      var handler = shelf.Pipeline()
          .addMiddleware(_loggingMiddleware)
          .addMiddleware(securityConfig.createSecurityMiddleware())
          .addMiddleware(_errorHandlingMiddleware)
          .addHandler(router);

      // Start server
      final server = await shelf_io.serve(handler, host, port);
      print('✅ Server listening on http://${server.address.host}:${server.port}');
      print('🎉 Backend ready! Test with: curl http://localhost:$port/health');
    } catch (e) {
      print('❌ Error starting server: $e');
      rethrow;
    }
  }

  /// Stop the backend server
  Future<void> stop() async {
    print('🛑 Server stopped');
  }
}

// Logging middleware
shelf.Middleware _loggingMiddleware = (innerHandler) {
  return (shelf.Request request) async {
    print('📨 ${request.method} ${request.url.path}');
    final response = await innerHandler(request);
    print('📤 ${response.statusCode} ${request.method} ${request.url.path}');
    return response;
  };
};

// Error handling middleware
shelf.Middleware _errorHandlingMiddleware = (innerHandler) {
  return (shelf.Request request) async {
    try {
      return await innerHandler(request);
    } catch (e) {
      print('❌ Error: $e');
      return shelf.Response.internalServerError(
        body: '{"error":"Internal server error"}',
        headers: {'Content-Type': 'application/json'},
      );
    }
  };
};

// Main entry point
Future<void> main(List<String> arguments) async {
  final backend = CodePushBackend(
    host: Platform.environment['SERVER_HOST'] ?? 'localhost',
    port: int.parse(Platform.environment['SERVER_PORT'] ?? '8080'),
  );

  // Handle shutdown signals
  ProcessSignal.sigint.watch().listen((_) {
    print('\n🛑 Shutting down gracefully...');
    backend.stop();
    exit(0);
  });

  await backend.start();
}

// Export security configuration for external use
export 'src/security_config.dart' show SecurityConfig, SecurityConfigException;

/// Main backend application
class CodePushBackend {
  final String host;
  final int port;
  final String dbUrl;
  final String jwtSecret;
  
  late HttpServer _server;

  CodePushBackend({
    this.host = '0.0.0.0',
    this.port = 8080,
    this.dbUrl = 'postgresql://localhost/quicui_codepush',
    this.jwtSecret = 'development-secret-key',
  });

  /// Start the backend server
  Future<void> start() async {
    try {
      print('🚀 Starting QuicUI Code Push Backend...');
      print('📝 Configuration:');
      print('   Host: $host');
      print('   Port: $port');
      print('   Database: $dbUrl');

      // Load security configuration
      late SecurityConfig securityConfig;
      try {
        securityConfig = SecurityConfig.fromEnvironment();
      } catch (e) {
        print('⚠️ Security configuration warning: $e');
        // In development, use default config; in production, this would fail
        securityConfig = SecurityConfig(
          allowedOrigins: ['http://localhost:3000'],
          debugMode: true,
        );
      }

      // Print security checklist
      securityConfig.printSecurityChecklistProduction();

      // Initialize database connection
      await _initializeDatabase();

      // Create request handler pipeline with security middleware
      var handler = const Pipeline()
          .addMiddleware(loggingMiddleware)
          .addMiddleware(securityConfig.createSecurityMiddleware())
          .addMiddleware(errorHandlingMiddleware)
          .addHandler(_router);

      // Bind server
      _server = await HttpServer.bind(host, port);
      print('✅ Server listening on http://$host:$port');

      // Serve requests
      await shelf_io.serve(handler, host, port);
    } catch (e) {
      print('❌ Error starting server: $e');
      rethrow;
    }
  }

  /// Stop the backend server
  Future<void> stop() async {
    await _server.close(force: true);
    print('🛑 Server stopped');
  }

  /// Initialize database connection
  Future<void> _initializeDatabase() async {
    print('🔄 Initializing database connection...');
    
    try {
      // In production, use actual database connection
      // For now, simulate connection
      await Future.delayed(Duration(milliseconds: 500));
      print('✅ Database connected');
    } catch (e) {
      print('❌ Database connection failed: $e');
      rethrow;
    }
  }

  /// Main request router
  FutureOr<Response> _router(Request request) {
    final path = request.url.path;
    final method = request.method;

    // Health check
    if (path == 'health' && method == 'GET') {
      return _handleHealth(request);
    }

    // Auth endpoints
    if (path.startsWith('api/v1/auth')) {
      return _handleAuth(request);
    }

    // Apps endpoints
    if (path.startsWith('api/v1/apps')) {
      return _handleApps(request);
    }

    // Patches endpoints
    if (path.contains('patches')) {
      return _handlePatches(request);
    }

    // Rollouts endpoints
    if (path.startsWith('api/v1/rollouts')) {
      return _handleRollouts(request);
    }

    // Metrics endpoints
    if (path.contains('metrics')) {
      return _handleMetrics(request);
    }

    return Response.notFound('Endpoint not found: $path');
  }

  /// Handle health check
  FutureOr<Response> _handleHealth(Request request) {
    return Response.ok(
      '{"status":"healthy","timestamp":"${DateTime.now().toIso8601String()}"}',
      headers: {'Content-Type': 'application/json'},
    );
  }

  /// Handle authentication endpoints
  FutureOr<Response> _handleAuth(Request request) {
    final path = request.url.path;
    final method = request.method;

    if (path.endsWith('register') && method == 'POST') {
      return _registerUser(request);
    }

    if (path.endsWith('login') && method == 'POST') {
      return _loginUser(request);
    }

    return Response.notFound('Auth endpoint not found');
  }

  /// Handle app management endpoints
  FutureOr<Response> _handleApps(Request request) {
    final method = request.method;
    final path = request.url.path;

    if (method == 'GET' && !path.contains('appId')) {
      return _listApps(request);
    }

    if (method == 'POST' && !path.contains('appId')) {
      return _createApp(request);
    }

    if (method == 'GET' && path.contains('appId')) {
      return _getApp(request);
    }

    return Response.notFound('Apps endpoint not found');
  }

  /// Handle patch endpoints
  FutureOr<Response> _handlePatches(Request request) {
    final method = request.method;
    final path = request.url.path;

    if (method == 'GET' && !path.contains('version')) {
      return _listPatches(request);
    }

    if (method == 'POST' && !path.contains('version')) {
      return _uploadPatch(request);
    }

    if (method == 'GET' && path.contains('version')) {
      return _getPatch(request);
    }

    if (method == 'DELETE') {
      return _deletePatch(request);
    }

    return Response.notFound('Patches endpoint not found');
  }

  /// Handle rollout endpoints
  FutureOr<Response> _handleRollouts(Request request) {
    final method = request.method;
    final path = request.url.path;

    if (method == 'GET' && !path.contains('rolloutId')) {
      return _listRollouts(request);
    }

    if (method == 'POST' && !path.contains('rolloutId')) {
      return _createRollout(request);
    }

    if (method == 'PATCH') {
      return _updateRollout(request);
    }

    return Response.notFound('Rollouts endpoint not found');
  }

  /// Handle metrics endpoints
  FutureOr<Response> _handleMetrics(Request request) {
    return _getMetrics(request);
  }

  // ==================== Endpoint Handlers ====================

  /// POST /api/v1/auth/register
  FutureOr<Response> _registerUser(Request request) async {
    try {
      final body = await request.readAsString();
      // Parse JSON: { "email", "password", "name" }
      
      return Response.ok(
        '{"userId":"user123","email":"user@example.com","createdAt":"${DateTime.now().toIso8601String()}"}',
        headers: {'Content-Type': 'application/json'},
      );
    } catch (e) {
      return Response.internalServerError(
        body: '{"error":"Registration failed: $e"}',
      );
    }
  }

  /// POST /api/v1/auth/login
  FutureOr<Response> _loginUser(Request request) async {
    try {
      final body = await request.readAsString();
      // Parse JSON: { "email", "password" }
      
      return Response.ok(
        '{"token":"jwt.token.here","expiresIn":3600}',
        headers: {'Content-Type': 'application/json'},
      );
    } catch (e) {
      return Response.internalServerError(
        body: '{"error":"Login failed: $e"}',
      );
    }
  }

  /// GET /api/v1/apps
  FutureOr<Response> _listApps(Request request) {
    return Response.ok(
      '{"apps":[{"id":"app1","name":"MyApp","platform":"flutter","createdAt":"2024-11-01T00:00:00Z"}]}',
      headers: {'Content-Type': 'application/json'},
    );
  }

  /// POST /api/v1/apps
  FutureOr<Response> _createApp(Request request) async {
    try {
      final body = await request.readAsString();
      // Parse JSON: { "name", "platform" }
      
      return Response.ok(
        '{"id":"app_new","name":"NewApp","platform":"flutter","createdAt":"${DateTime.now().toIso8601String()}"}',
        headers: {'Content-Type': 'application/json'},
        statusCode: 201,
      );
    } catch (e) {
      return Response.internalServerError(
        body: '{"error":"App creation failed: $e"}',
      );
    }
  }

  /// GET /api/v1/apps/{appId}
  FutureOr<Response> _getApp(Request request) {
    return Response.ok(
      '{"id":"app1","name":"MyApp","platform":"flutter","patchCount":5,"createdAt":"2024-11-01T00:00:00Z"}',
      headers: {'Content-Type': 'application/json'},
    );
  }

  /// GET /api/v1/apps/{appId}/patches
  FutureOr<Response> _listPatches(Request request) {
    return Response.ok(
      '''{"patches":[
        {"version":"1.0.0","size":1024,"critical":false,"createdAt":"2024-11-01T00:00:00Z"},
        {"version":"1.0.1","size":512,"critical":false,"createdAt":"2024-11-02T00:00:00Z"}
      ]}''',
      headers: {'Content-Type': 'application/json'},
    );
  }

  /// POST /api/v1/apps/{appId}/patches
  FutureOr<Response> _uploadPatch(Request request) async {
    try {
      final body = await request.readAsString();
      // Parse multipart: patch file + metadata
      
      return Response.ok(
        '{"version":"1.0.2","size":512,"signature":"sig123","uploadedAt":"${DateTime.now().toIso8601String()}"}',
        headers: {'Content-Type': 'application/json'},
        statusCode: 201,
      );
    } catch (e) {
      return Response.internalServerError(
        body: '{"error":"Patch upload failed: $e"}',
      );
    }
  }

  /// GET /api/v1/apps/{appId}/patches/{version}
  FutureOr<Response> _getPatch(Request request) {
    return Response.ok(
      '''{"version":"1.0.1","size":512,"critical":false,"signature":"sig123","downloadUrl":"https://cdn.quicui.dev/patch.bin","createdAt":"2024-11-02T00:00:00Z"}''',
      headers: {'Content-Type': 'application/json'},
    );
  }

  /// DELETE /api/v1/apps/{appId}/patches/{version}
  FutureOr<Response> _deletePatch(Request request) {
    return Response.ok(
      '{"deleted":true,"version":"1.0.1"}',
      headers: {'Content-Type': 'application/json'},
    );
  }

  /// GET /api/v1/apps/{appId}/metrics
  FutureOr<Response> _getMetrics(Request request) {
    return Response.ok(
      '''{"appId":"app1","totalDownloads":15000,"activeUsers":1200,"successRate":99.5,"averageDownloadTime":2500}''',
      headers: {'Content-Type': 'application/json'},
    );
  }

  /// POST /api/v1/rollouts
  FutureOr<Response> _createRollout(Request request) async {
    try {
      final body = await request.readAsString();
      // Parse JSON: { "appId", "version", "percentage", "environment" }
      
      return Response.ok(
        '{"rolloutId":"rollout123","version":"1.0.2","percentage":10,"status":"active","createdAt":"${DateTime.now().toIso8601String()}"}',
        headers: {'Content-Type': 'application/json'},
        statusCode: 201,
      );
    } catch (e) {
      return Response.internalServerError(
        body: '{"error":"Rollout creation failed: $e"}',
      );
    }
  }

  /// GET /api/v1/rollouts
  FutureOr<Response> _listRollouts(Request request) {
    return Response.ok(
      '''{"rollouts":[
        {"id":"rollout1","version":"1.0.1","percentage":100,"status":"completed"},
        {"id":"rollout2","version":"1.0.2","percentage":50,"status":"active"}
      ]}''',
      headers: {'Content-Type': 'application/json'},
    );
  }

  /// PATCH /api/v1/rollouts/{rolloutId}
  FutureOr<Response> _updateRollout(Request request) async {
    try {
      final body = await request.readAsString();
      // Parse JSON: { "percentage" } to update rollout percentage
      
      return Response.ok(
        '{"id":"rollout2","version":"1.0.2","percentage":75,"status":"active","updatedAt":"${DateTime.now().toIso8601String()}"}',
        headers: {'Content-Type': 'application/json'},
      );
    } catch (e) {
      return Response.internalServerError(
        body: '{"error":"Rollout update failed: $e"}',
      );
    }
  }
}

// ==================== Middleware ====================

/// Logging middleware
Middleware loggingMiddleware = (innerHandler) {
  return (request) async {
    print('📨 ${request.method} ${request.url.path}');
    
    final response = await innerHandler(request);
    
    print('📤 ${response.statusCode} ${request.method} ${request.url.path}');
    return response;
  };
};

/// CORS middleware
Middleware corsMiddleware = (innerHandler) {
  return (request) async {
    final response = await innerHandler(request);
    
    return response.change(headers: {
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'GET, POST, PUT, PATCH, DELETE, OPTIONS',
      'Access-Control-Allow-Headers': 'Content-Type, Authorization',
    });
  };
};

/// Error handling middleware
Middleware errorHandlingMiddleware = (innerHandler) {
  return (request) async {
    try {
      return await innerHandler(request);
    } catch (e) {
      print('❌ Error: $e');
      
      return Response.internalServerError(
        body: '{"error":"Internal server error: $e"}',
        headers: {'Content-Type': 'application/json'},
      );
    }
  };
};

// ==================== Main ====================

Future<void> main(List<String> arguments) async {
  final backend = CodePushBackend(
    host: '0.0.0.0',
    port: 8080,
  );

  // Handle shutdown signals
  ProcessSignal.sigint.watch().listen((_) {
    print('\n🛑 Shutting down gracefully...');
    backend.stop();
    exit(0);
  });

  ProcessSignal.sigterm.watch().listen((_) {
    print('\n🛑 Shutting down gracefully...');
    backend.stop();
    exit(0);
  });

  await backend.start();
}

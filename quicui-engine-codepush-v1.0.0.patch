+bool CodePushLoader::InstallAOTSnapshot(const std::string& patch_path,
+                                       const std::string& architecture) {
+  if (code_cache_dir_.empty()) {
+    std::cerr << "Code cache directory not set" << std::endl;
+    return false;
+  }
+
+  // Create patches directory
+  std::string patches_dir = code_cache_dir_ + "/quicui_patches";
+  std::string mkdir_cmd = "mkdir -p " + patches_dir;
+  system(mkdir_cmd.c_str());
+
+  // Target path: libapp_patched_<arch>.so
+  std::string target_path = patches_dir + "/libapp_patched_" + architecture + ".so";
+
+  // Copy patch file
+  std::string copy_cmd = "cp " + patch_path + " " + target_path;
+  int result = system(copy_cmd.c_str());
+
+  if (result != 0) {
+    std::cerr << "Failed to copy patch to: " << target_path << std::endl;
+    return false;
+  }
+
+  // Set executable permissions
+  std::string chmod_cmd = "chmod 755 " + target_path;
+  system(chmod_cmd.c_str());
+
+  std::cout << "AOT snapshot installed: " << target_path << std::endl;
+  return true;
+}
+
+bool CodePushLoader::ValidateAOTSnapshot(const std::string& path,
+                                        const std::string& expected_hash) {
+  // Check file exists
+  struct stat buffer;
+  if (stat(path.c_str(), &buffer) != 0) {
+    return false;
+  }
+
+  // Calculate hash
+  std::string calculated_hash = CalculatePatchHash(path);
+  if (calculated_hash.empty()) {
+    std::cerr << "Failed to calculate patch hash" << std::endl;
+    return false;
+  }
+
+  // Compare hashes
+  if (calculated_hash != expected_hash) {
+    std::cerr << "Hash mismatch - Expected: " << expected_hash 
+              << ", Got: " << calculated_hash << std::endl;
+    return false;
+  }
+
+  return true;
+}
+
+std::string CodePushLoader::GetCodeCacheDir() {
+  return code_cache_dir_;
